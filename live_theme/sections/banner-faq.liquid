{% schema %}
{
  "name": "Banner FAQ",
  "tag": "section",
  "class": "banner-faq-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_desktop",
      "label": "Imagem para Desktop"
    },
    {
      "type": "image_picker",
      "id": "banner_mobile",
      "label": "Imagem para Mobile"
    },
    {
      "type": "url",
      "id": "link_banner",
      "label": "Link do banner (opcional)"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Texto alternativo (acessibilidade)",
      "default": "Perguntas frequentes PlusSim"
    }
  ],
  "presets": [
    {
      "name": "Banner FAQ",
      "category": "Banners"
    }
  ]
}
{% endschema %}

{% assign banner_desktop = section.settings.banner_desktop %}
{% assign banner_mobile = section.settings.banner_mobile %}
{% assign alt_text = section.settings.alt_text | escape %}

<div class="banner-faq-wrapper">
  {% if section.settings.link_banner != blank %}
    <a href="{{ section.settings.link_banner }}" class="banner-link">
  {% endif %}

  <picture>
    {% if banner_mobile != blank %}
      <source media="(max-width: 749px)" srcset="{{ banner_mobile | image_url: width: 800 }}">
    {% endif %}
    {% if banner_desktop != blank %}
      <source media="(min-width: 750px)" srcset="{{ banner_desktop | image_url: width: 1600 }}">
      <img
        src="{{ banner_desktop | image_url: width: 1600 }}"
        alt="{{ alt_text }}"
        class="banner-img"
        loading="lazy"
        width="100%"
      >
    {% endif %}
  </picture>

  {% if section.settings.link_banner != blank %}
    </a>
  {% endif %}
</div>

<style>
  .banner-faq-wrapper {
    width: 100%;
    display: block;
    margin-bottom: 20px;
  }

  .banner-faq-wrapper img {
    width: 100%;
    height: auto;
    display: block;
  }

  .banner-link {
    display: block;
    text-decoration: none;
  }
</style>