      display: none;
    }

    /* Ajustes dos ícones */
    .bi, .material-symbols-outlined {
      color: #60C2EA;
      font-size: 25px;
    }

    /* Ajustes do avião e linha tracejada */
    .airplane-wrapper {
      position: absolute;
      width: 100%;
      height: 100%;
      bottom: 0;
      right: 0;
      z-index: 0;
    }

    .airplane {
      position: absolute;
      width: 26%;
      height: 30%;
      top: 117.61px;
      left: 1px;
      transform: rotate(64.22deg);
    }

    .dashed-line {
      position: absolute;
      width: 500.39px;
      height: 402.77px;
      top: 196px;
      left: -122.31px;
      border: 1px;
      transform: rotate(-283.83deg);
    }
  }

  /* Telas menores (375px ou menos) */
  @media (max-width: 375px) {
