    <script src="https://code.jquery.com/jquery-3.6.0.min.js" integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4=" crossorigin="anonymous"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const cartItems = document.querySelectorAll('.cart-item');
        cartItems.forEach(item => {
          const qtyInput = item.querySelector('.product-quantity-input');
          const qtyMinusBtn = item.querySelector('.minus');
          const qtyPlusBtn = item.querySelector('.plus');
          const minQty = parseInt(qtyInput.min || 1);

          qtyMinusBtn.addEventListener('click', function() {
            let value = parseInt(qtyInput.value);
            if (value > minQty) {
              qtyInput.value = value - 1;
              updateCart(qtyInput);
            }
          });

          qtyPlusBtn.addEventListener('click', function() {
            let value = parseInt(qtyInput.value);
            qtyInput.value = value + 1;
            updateCart(qtyInput);
          });

          qtyInput.addEventListener('change', function() {
            if (parseInt(qtyInput.value) < minQty) {
              qtyInput.value = minQty;
            }
            updateCart(qtyInput);
          });

          function updateCart(input) {
            const form = input.closest('form');
            const id = input.dataset.id;
            const quantity = input.value;

            fetch('/cart/change.js', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                id: id,
                quantity: quantity
              })
            })
            .then(response => response.json())
            .then(data => {
              const totalsElement = form.querySelector('[data-cart-totals] .cart-price.money');
              totalsElement.textContent = `Total ${Shopify.formatMoney(data.total_price)}`;
              const lineItem = Vecchioinput.closest('.line-item');
              const priceElement = lineItem.querySelector('.line-item-final-price');
              const item = data.items.find(i => i.key === id);
              priceElement.textContent = Shopify.formatMoney(item.final_price);
            })
            .catch(error => console.error('Error updating cart:', error));
          }
        });

        // From hear-about-us.liquid
        jQuery(function($) {
          $('#how-did-you-hear-about-us').change(function() {
            if ($('#how-did-you-hear-about-us').val() == 'Other') {
              $('#how-did-you-hear-about-us-other').parent('p').show();
            } else {
              $('#how-did-you-hear-about-us-other').val('').parent('p').hide();
            }
          });

          $('[name="checkout"], [name="goto_pp"], [name="goto_gc"]').click(function(e) {
            e.preventDefault();
            var validated = true;
            if ($('#how-did-you-hear-about-us').val() == '') {
              validated = false;
            } else if ($('#how-did-you-hear-about-us').val() == 'Other') {
              if ($('#how-did-you-hear-about-us-other').val() == '') {
                validated = false;
                $('#how-did-you-hear-about-us-other').addClass('error');
              }
            }
            if (validated) {
              $(this).unbind('click').click();
            } else {
              alert("O campo Como conheceu a PlusSim é obrigatório");
              return false;
            }
          });
        });
      });

      Shopify.formatMoney = function(cents, format = "{{ amount }}") {
        if (typeof cents === 'string') {
          cents = cents.replace('.', '');
        }
        let value = '';
        const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;
        function formatWithDelimiters(number, precision = 2, thousands = ',', decimal = '.') {
          if (isNaN(number) || number == null) {
            return 0;
          }
          number = (number / 100.0).toFixed(precision);
          const parts = number.split('.');
          const dollars = parts[0].replace(/(\d)(?=(\d{3})+(?!\d))/g, `$1${thousands}`);
          const centsPart = parts[1] ? decimal + parts[1] : '';
          return dollars + centsPart;
        }
        if (format.match(placeholderRegex)) {
          value = format.replace(placeholderRegex, formatWithDelimiters(cents));
        }
        return value;
      };
    </script>
  </form>

