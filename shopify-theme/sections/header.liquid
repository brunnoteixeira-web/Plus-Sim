<div id="header-wrapper" class="w-full">
  <!-- BARRA DE VANTAGENS -->
  <div class="bg-[#1A2B6D] text-white py-2.5 px-4 text-center text-[10px] md:text-xs font-bold tracking-wider relative z-[60]">
      <div class="max-w-7xl mx-auto flex flex-wrap justify-center items-center gap-x-4 gap-y-2 md:gap-12">
          <span class="flex items-center gap-2 whitespace-nowrap">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#A64DFF]"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg> 
              PIX COM 5% DE DESCONTO
          </span>
          <span class="flex items-center gap-2 whitespace-nowrap">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00D1FF]"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect><line x1="1" y1="10" x2="23" y2="10"></line></svg> 
              PARCELE EM ATÉ 12X
          </span>
          <span class="flex items-center gap-2 whitespace-nowrap">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-400"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> 
              SUPORTE 24H
          </span>
      </div>
  </div>

  <!-- CABEÇALHO (BARRA DE MENU BRANCA) -->
  <nav class="sticky top-0 z-50 bg-white shadow-md py-0">
      <div class="max-w-7xl mx-auto px-6 h-full flex justify-between items-center py-4">
          <!-- Logo -->
          <a href="{{ routes.root_url }}" class="flex items-center cursor-pointer">
              {% if section.settings.logo != blank %}
                  <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" class="h-10 md:h-12 w-auto object-contain" />
              {% else %}
                  <span class="text-2xl font-black text-[#1A2B6D]">{{ shop.name }}</span>
              {% endif %}
          </a>

          <!-- Desktop Menu -->
          <div class="hidden md:flex items-center gap-8 font-bold text-[#1A2B6D]">
              <a href="/collections/esim" class="hover:text-[#2E5BFF] transition-colors">Planos eSIM</a>
              <a href="/collections/chip-fisico" class="hover:text-[#2E5BFF] transition-colors">Planos Chip Físico</a>
              <a href="/pages/compatibilidade" class="hover:text-[#2E5BFF] transition-colors">Compatibilidade eSIM</a>
              <a href="/blogs/news" class="hover:text-[#2E5BFF] transition-colors">Blog</a>
              
              <div class="h-6 w-px bg-slate-200"></div>
              
              <!-- Cart -->
              <a href="{{ routes.cart_url }}" class="relative p-2 hover:bg-slate-100 rounded-full text-[#1A2B6D]">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                  <span class="absolute top-0 right-0 w-4 h-4 bg-[#A64DFF] text-white text-[10px] rounded-full flex items-center justify-center font-bold" id="cart-icon-bubble">{{ cart.item_count }}</span>
              </a>
          </div>

          <!-- Mobile Menu Button -->
          <button id="mobile-menu-toggle" class="md:hidden text-[#1A2B6D]">
              <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
              <svg id="close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
      </div>

      <!-- Mobile Menu Dropdown -->
      <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-slate-100 absolute w-full left-0 p-6 flex flex-col gap-4 shadow-xl">
          <a href="/collections/esim" class="text-left font-bold text-[#1A2B6D]">Planos eSIM</a>
          <a href="/collections/chip-fisico" class="text-left font-bold text-[#1A2B6D]">Planos Chip Físico</a>
          <a href="/pages/compatibilidade" class="text-left font-bold text-[#1A2B6D]">Compatibilidade eSIM</a>
          <a href="/blogs/news" class="font-bold text-[#1A2B6D]">Blog</a>
      </div>
  </nav>
</div>

{% schema %}
{
  "name": "Cabeçalho",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Principal"
    }
  ]
}
{% endschema %}
