<section class="relative min-h-[500px] md:min-h-[600px] flex items-center py-20 overflow-hidden">
  <div class="absolute inset-0 z-0">
      {% if section.settings.background_image %}
        <img src="{{ section.settings.background_image | image_url: width: 1920 }}" alt="{{ section.settings.background_image.alt | escape }}" class="w-full h-full object-cover" />
      {% else %}
        <img src="{{ 'airplane background.jpg' | asset_url }}" alt="Airplane Background" class="w-full h-full object-cover" />
      {% endif %}
      <div class="absolute inset-0 bg-gradient-to-r from-[#4b209c] via-[#5A2B99]/80 to-[#6E3BB2]/20 backdrop-blur-[2px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-12 gap-12 items-center relative z-10 text-white w-full">
      <div class="md:col-span-7 text-center md:text-left">
          <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/10 backdrop-blur-md border border-white/20 rounded-full mb-6 text-xs font-bold uppercase tracking-widest">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00D1FF]"><polyline points="20 6 9 17 4 12"></polyline></svg>
              {{ section.settings.badge_text }}
          </div>

          <h1 class="text-5xl md:text-7xl font-black leading-[1.1] mb-8 tracking-tighter">
              {{ section.settings.headline_part1 | newline_to_br }}<br />
              <span class="text-[#93C5FD]">{{ section.settings.headline_highlight }}</span>
          </h1>

          <p class="text-lg md:text-xl text-white/90 mb-6 max-w-xl font-medium leading-relaxed">
              {{ section.settings.subheading | newline_to_br }}
          </p>
      </div>

      <!-- CARD DE STATUS -->
      <div class="md:col-span-5 flex justify-center md:justify-end">
          <div class="relative w-full max-w-[340px] aspect-square bg-[#A66DFF]/20 backdrop-blur-2xl border border-white/20 rounded-[40px] p-10 flex flex-col justify-between shadow-2xl animate-floating">
              <div class="flex justify-between items-start">
                  <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white/80"><path d="M5 12.55a11 11 0 0 1 14.08 0"></path><path d="M1.42 9a16 16 0 0 1 21.16 0"></path><path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path><line x1="12" y1="20" x2="12.01" y2="20"></line></svg>
                  <div class="flex items-center gap-2 px-3 py-1 bg-[#4ADE80]/20 text-[#4ADE80] rounded-full text-[10px] font-black uppercase tracking-widest border border-[#4ADE80]/30 backdrop-blur-md">
                      <div class="w-1.5 h-1.5 rounded-full bg-[#4ADE80] animate-pulse"></div> ONLINE
                  </div>
              </div>

              <div class="py-8">
                  <div class="text-7xl font-black tracking-tighter mb-1">5G</div>
                  <div class="text-xs font-bold uppercase tracking-[0.2em] opacity-80 text-[#00D1FF]">Ultra Velocidade</div>
              </div>

              <div class="flex items-center gap-5 pt-8 border-t border-white/10">
                  <div class="w-14 h-10 bg-gradient-to-br from-[#E2B04E] via-[#FFD700] to-[#B8860B] rounded-lg shadow-lg relative overflow-hidden flex-shrink-0 border border-black/10">
                      <div class="absolute inset-1.5 border border-black/10 rounded-sm opacity-40">
                          <div class="absolute top-0 bottom-0 left-1/2 w-px bg-black/40"></div>
                          <div class="absolute left-0 right-0 top-1/2 h-px bg-black/40"></div>
                      </div>
                      <div class="absolute -top-10 -left-10 w-20 h-40 bg-white/20 rotate-45 pointer-events-none"></div>
                  </div>
                  <div>
                      <div class="text-[10px] font-bold uppercase opacity-60 tracking-widest mb-0.5">Status do SIM</div>
                      <div class="text-sm font-black uppercase tracking-tight text-white">Pronto para uso</div>
                  </div>
              </div>
          </div>
      </div>
  </div>
</section>

{% schema %}
{
  "name": "Banner Principal",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Imagem de Fundo"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texto da Etiqueta",
      "default": "Viaje Conectado"
    },
    {
      "type": "textarea",
      "id": "headline_part1",
      "label": "Título Parte 1",
      "default": "Sua internet global"
    },
    {
      "type": "text",
      "id": "headline_highlight",
      "label": "Título Destacado",
      "default": "sem fronteiras"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Chegue ao seu destino conectado!\nInternet 5G ilimitada nos EUA, Europa, Ásia e + 200 destinos"
    }
  ],
  "presets": [
    {
      "name": "Banner Principal"
    }
  ]
}
{% endschema %}
