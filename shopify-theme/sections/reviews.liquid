<section class="py-24 bg-white text-center relative overflow-hidden" id="shopify-section-reviews">
  <div class="max-w-7xl mx-auto px-6 relative">
      <div class="mb-16 flex flex-col items-center gap-6">
          <div class="text-center w-full">
              <h2 class="text-4xl md:text-5xl font-black text-[#1A2B6D] mb-4 tracking-tighter">{{ section.settings.heading }}</h2>
              <p class="text-slate-500 text-lg font-medium opacity-70">{{ section.settings.subheading }}</p>
          </div>
      </div>
      
      <div class="relative">
          <button id="prev-review" class="absolute top-1/2 -translate-y-1/2 -left-3 md:-left-6 lg:-left-12 z-20 w-12 h-12 rounded-full bg-white flex items-center justify-center text-[#1A2B6D] hover:bg-[#1A2B6D] hover:text-white transition-all shadow-[0_0_15px_rgba(0,0,0,0.1)] border border-slate-100 active:scale-90">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          
          <button id="next-review" class="absolute top-1/2 -translate-y-1/2 -right-3 md:-right-6 lg:-right-12 z-20 w-12 h-12 rounded-full bg-white flex items-center justify-center text-[#1A2B6D] hover:bg-[#1A2B6D] hover:text-white transition-all shadow-[0_0_15px_rgba(0,0,0,0.1)] border border-slate-100 active:scale-90">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
          
          <div class="relative overflow-hidden px-1 py-4">
              <div id="reviews-track" class="flex transition-transform duration-500 ease-out gap-6">
                  {% for block in section.blocks %}
                  <div class="min-w-full md:min-w-[calc(33.333%-16px)] bg-white p-8 rounded-[32px] border border-slate-100 shadow-sm hover:shadow-md transition-all flex flex-col text-left h-full">
                      <div class="flex text-yellow-400 gap-0.5 mb-6">
                          {% for i in (1..5) %}
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                          {% endfor %}
                      </div>
                      <p class="text-[#1A2B6D] font-medium leading-relaxed mb-8 flex-grow italic text-sm md:text-base">"{{ block.settings.text }}"</p>
                      <div>
                          <h5 class="font-black text-[#1A2B6D] text-base mb-2">{{ block.settings.author }}</h5>
                          <div class="inline-block px-3 py-1 bg-[#F3E8FF] text-[#A64DFF] rounded-full text-[10px] font-black uppercase tracking-widest">{{ block.settings.location }}</div>
                      </div>
                  </div>
                  {% endfor %}
              </div>
          </div>
      </div>
      
      <div id="reviews-dots" class="mt-10 flex justify-center gap-2">
          <!-- Dots inseridos por JS -->
      </div>
  </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const track = document.getElementById('reviews-track');
  const prevBtn = document.getElementById('prev-review');
  const nextBtn = document.getElementById('next-review');
  const dotsContainer = document.getElementById('reviews-dots');
  
  if (!track || !prevBtn || !nextBtn) return;
  
  const blocksCount = {{ section.blocks.size }};
  let currentIndex = 0;
  
  // Create dots
  for(let i = 0; i < blocksCount; i++) {
      const dot = document.createElement('button');
      dot.className = `h-2 rounded-full transition-all duration-300 ${i === 0 ? 'w-8 bg-[#A64DFF]' : 'w-2 bg-slate-200 hover:bg-slate-300'}`;
      dot.addEventListener('click', () => {
          currentIndex = i;
          updateCarousel();
      });
      dotsContainer.appendChild(dot);
  }
  
  function updateCarousel() {
      const isMobile = window.innerWidth < 768;
      const visibleItems = isMobile ? 1 : 3;
      const itemWidth = 100 / visibleItems;
      track.style.transform = `translateX(-${currentIndex * itemWidth}%)`;
      
      // Update dots
      Array.from(dotsContainer.children).forEach((dot, index) => {
          if(index === currentIndex) {
              dot.className = 'h-2 rounded-full transition-all duration-300 w-8 bg-[#A64DFF]';
          } else {
              dot.className = 'h-2 rounded-full transition-all duration-300 w-2 bg-slate-200 hover:bg-slate-300';
          }
      });
  }
  
  prevBtn.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + blocksCount) % blocksCount;
      updateCarousel();
  });
  
  nextBtn.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % blocksCount;
      updateCarousel();
  });
  
  window.addEventListener('resize', updateCarousel);
});
</script>

{% schema %}
{
"name": "Avaliações",
"settings": [
  {
    "type": "text",
    "id": "heading",
    "label": "Título",
    "default": "O que nossos clientes dizem"
  },
  {
    "type": "text",
    "id": "subheading",
    "label": "Subtítulo",
    "default": "Mais de 8 anos conectando brasileiros ao redor do mundo"
  }
],
"blocks": [
  {
    "type": "review",
    "name": "Avaliação",
    "settings": [
      {
        "type": "text",
        "id": "author",
        "label": "Nome do Cliente",
        "default": "João Silva"
      },
      {
        "type": "textarea",
        "id": "text",
        "label": "Depoimento",
        "default": "Excelente atendimento e conexão muito rápida. Recomendo demais!"
      },
      {
        "type": "text",
        "id": "location",
        "label": "Destino da Viagem",
        "default": "Estados Unidos"
      }
    ]
  }
],
"presets": [
  {
    "name": "Avaliações",
    "blocks": [
      { "type": "review", "settings": { "author": "Bárbara Luiza Cardoso", "text": "A melhor de todas as empresas, principalmente no pós venda!!", "location": "Estados Unidos" } },
      { "type": "review", "settings": { "author": "Merinson Scaranello", "text": "Excelente chip... usei nos USA... precisei tirar algumas dúvidas...", "location": "Estados Unidos" } },
      { "type": "review", "settings": { "author": "Luciana", "text": "Excelente suporte via WhatsApp e a internet funcionou super bem.", "location": "Europa" } },
      { "type": "review", "settings": { "author": "Rodrigo Alves", "text": "Ativação instantânea do eSIM. Foi só chegar no aeroporto e usar.", "location": "Ásia" } }
    ]
  }
]
}
{% endschema %}
