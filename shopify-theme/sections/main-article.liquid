<article class="min-h-screen bg-white pb-24 animate-in fade-in duration-500">
  <!-- Article Hero -->
  <header class="relative pt-32 pb-16 md:pt-40 md:pb-24 bg-[#F8FAFC] border-b border-slate-100 overflow-hidden">
    <!-- Decoração de fundo -->
    <div class="absolute top-0 right-0 -translate-y-1/3 translate-x-1/3 w-[800px] h-[800px] bg-gradient-to-bl from-[#2E5BFF]/10 to-transparent rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="max-w-4xl mx-auto px-6 relative z-10 text-center">
      <!-- Tags -->
      {% if article.tags.size > 0 %}
        <div class="flex flex-wrap items-center justify-center gap-2 mb-6">
          {% for tag in article.tags %}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="bg-blue-50 text-[#2E5BFF] hover:bg-[#2E5BFF] hover:text-white transition-colors text-xs font-black uppercase tracking-widest px-4 py-1.5 rounded-full shadow-sm">{{ tag }}</a>
          {% endfor %}
        </div>
      {% endif %}

      <!-- Título -->
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-[#1A2B6D] tracking-tighter leading-tight mb-8">
        {{ article.title }}
      </h1>

      <!-- Meta Info -->
      <div class="flex items-center justify-center gap-6 text-sm font-bold text-slate-500">
        <div class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2E5BFF]"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          {{ article.published_at | date: "%d/%m/%Y" }}
        </div>
        {% if section.settings.show_author %}
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2E5BFF]"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            {{ article.author }}
          </div>
        {% endif %}
      </div>
    </div>
  </header>

  <div class="max-w-4xl mx-auto px-6 -mt-10 relative z-20">
    <!-- Imagem de Capa (se houver) -->
    {% if article.image %}
      <div class="w-full aspect-[16/9] md:aspect-[21/9] bg-slate-100 rounded-[32px] shadow-2xl overflow-hidden mb-16 border-4 border-white">
        <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.image.alt | escape }}" class="w-full h-full object-cover" loading="eager">
      </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Conteúdo Principal -->
      <div class="lg:col-span-8">
        <div class="prose prose-lg prose-slate max-w-none prose-headings:font-black prose-headings:text-[#1A2B6D] prose-headings:tracking-tight prose-a:text-[#2E5BFF] prose-a:font-bold prose-img:rounded-3xl prose-img:shadow-md">
          {{ article.content }}
        </div>

        <!-- Botão Voltar para o Blog -->
        <div class="mt-16 pt-8 border-t border-slate-100">
          <a href="{{ blog.url }}" class="inline-flex items-center gap-2 font-black text-[#1A2B6D] hover:text-[#2E5BFF] transition-colors text-sm uppercase tracking-widest">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Voltar para todos os artigos
          </a>
        </div>
      </div>

      <!-- Sidebar / CTA (Call to Action) -->
      <aside class="lg:col-span-4">
        <div class="sticky top-8">
          <!-- Banner de Venda (Sim Plus) -->
          <div class="bg-[#1A2B6D] rounded-[32px] p-8 text-white shadow-xl relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-[#2E5BFF]/30 to-transparent opacity-50"></div>
            
            <div class="relative z-10 text-center flex flex-col items-center">
              <div class="w-16 h-16 bg-white/10 rounded-2xl flex items-center justify-center backdrop-blur-sm mb-6 shadow-inner border border-white/20">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-white"><rect x="2" y="2" width="20" height="20" rx="4" ry="4"></rect><line x1="22" y1="9" x2="2" y2="9"></line><line x1="22" y1="15" x2="2" y2="15"></line><line x1="9" y1="22" x2="9" y2="2"></line><line x1="15" y1="22" x2="15" y2="2"></line></svg>
              </div>
              
              <h3 class="text-2xl font-black tracking-tight mb-3">{{ section.settings.cta_title }}</h3>
              <p class="text-white/80 font-medium text-sm mb-8 leading-relaxed">{{ section.settings.cta_text }}</p>
              
              <a href="{{ section.settings.cta_link | default: routes.root_url }}" class="w-full bg-white text-[#1A2B6D] px-6 py-4 rounded-xl font-black shadow-lg hover:shadow-[0_0_20px_rgb(255,255,255,0.4)] transition-all hover:-translate-y-1 text-sm uppercase tracking-widest">
                {{ section.settings.cta_button }}
              </a>
            </div>
          </div>
        </div>
      </aside>

    </div>
  </div>
</article>

{% schema %}
{
  "name": "Página do Artigo",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Mostrar autor do artigo",
      "default": true
    },
    {
      "type": "header",
      "content": "Banner Lateral de Vendas"
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "Título do Banner",
      "default": "Vai viajar?"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "Texto do Banner",
      "default": "Não fique sem internet no exterior. Compre seu eSIM Plus Sim agora e viaje conectado."
    },
    {
      "type": "text",
      "id": "cta_button",
      "label": "Texto do Botão",
      "default": "Ver Planos"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Link do Botão"
    }
  ]
}
{% endschema %}
