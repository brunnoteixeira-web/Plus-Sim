<div class="min-h-screen bg-[#F8FAFC] font-sans text-[#1A2B6D] pb-20 pt-12">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid lg:grid-cols-12 gap-8 items-start">
      
      <!-- Coluna da Esquerda: Imagem e Detalhes -->
      <div class="lg:col-span-5 space-y-6">
        <div class="relative rounded-[40px] overflow-hidden shadow-2xl bg-white p-3 border border-slate-100">
           {% if product.featured_image %}
             <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title }}" class="w-full aspect-[4/3] object-cover rounded-[32px]">
           {% else %}
             <div class="w-full aspect-[4/3] rounded-[32px] bg-slate-100 flex items-center justify-center text-slate-400">Sem imagem</div>
           {% endif %}
        </div>

        <div class="bg-white rounded-3xl p-8 border border-slate-100 shadow-sm space-y-4">
           <h4 class="font-black text-base uppercase tracking-widest border-b border-slate-50 pb-4">Detalhes do Plano</h4>
           
           {% if product.description != blank %}
             <div class="space-y-3 mb-6 prose-p:text-base prose-p:font-medium prose-p:text-slate-600 prose-ul:space-y-3 prose-li:flex prose-li:items-center prose-li:gap-3 prose-li:text-base prose-li:font-medium prose-li:text-slate-600">
               {{ product.description }}
             </div>
           {% else %}
             <ul class="space-y-3 mb-6">
                <li class="flex items-center gap-3 text-base font-medium text-slate-600">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500 flex-shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg> 
                  Cobertura nos principais destinos
                </li>
                <li class="flex items-center gap-3 text-base font-medium text-slate-600">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500 flex-shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg> 
                  Internet de alta velocidade garantida
                </li>
                <li class="flex items-center gap-3 text-base font-medium text-slate-600">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500 flex-shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg> 
                  WhatsApp livre para fotos e mensagens
                </li>
             </ul>
           {% endif %}

           <div class="pt-4 border-t border-slate-50">
              <a href="{{ section.settings.compatibility_page.url | default: '/pages/compatibilidade' }}" class="flex gap-3 p-4 bg-amber-50 rounded-2xl border border-amber-100 group transition-all hover:bg-amber-100">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-amber-600 flex-shrink-0"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                <p class="text-[11px] font-bold text-amber-800 leading-relaxed">
                  Verifique se o seu celular é compatível com o eSIM <span class="text-amber-600 underline group-hover:text-amber-700 block mt-1">Clique aqui e saiba como verificar</span>
                </p>
              </a>
           </div>
        </div>
      </div>

      <!-- Coluna da Direita: Formulário de Compra -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-[40px] p-8 md:p-12 shadow-xl border border-white relative overflow-hidden h-full flex flex-col">
            <div class="absolute top-0 left-0 h-1.5 bg-gradient-to-r from-[#00D1FF] via-[#2E5BFF] to-[#A64DFF] w-full"></div>
            
            <div class="mb-10">
                {% if section.settings.show_top_choice %}
                <div class="flex items-center gap-2 mb-4">
                    <div class="flex text-yellow-400">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                    </div>
                    <span class="text-sm font-black text-[#A64DFF]">{{ section.settings.top_choice_text }}</span>
                </div>
                {% endif %}
                
                <h1 class="text-2xl md:text-3xl font-black tracking-tight mb-6 py-1 leading-snug text-transparent bg-clip-text bg-gradient-to-r from-[#1A2B6D] to-[#2E5BFF]">
                  {{ product.title }}
                </h1>
                
                <div class="flex gap-3 max-w-sm">
                    {% assign lower_title = product.title | downcase %}
                    {% if lower_title contains 'físico' or lower_title contains 'fisico' %}
                    <div class="bg-cyan-50/50 border border-cyan-100 rounded-2xl py-2.5 px-4 flex items-center gap-2">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00D1FF]"><rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect><path d="M6 4v4"></path><path d="M10 4v4"></path><path d="M14 4v4"></path><path d="M18 4v4"></path></svg>
                        <span class="font-black text-sm text-[#00D1FF] leading-none uppercase">Chip Físico</span>
                    </div>
                    {% else %}
                    <div class="bg-purple-50/50 border border-purple-100 rounded-2xl py-2.5 px-4 flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#A64DFF]"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="3"></rect><rect x="14" y="7" width="3" height="3"></rect><rect x="7" y="14" width="3" height="3"></rect><rect x="14" y="14" width="3" height="3"></rect></svg>
                        <span class="font-black text-sm text-[#A64DFF] leading-none uppercase">eSIM</span>
                    </div>
                    {% endif %}
                </div>
            </div>

            {% form 'product', product, class: 'flex-grow flex flex-col', id: 'add-to-cart-form' %}
              
              <!-- 1. Opção Primária (Botões de Plano) -->
              {% if product.options_with_values.size > 0 %}
                {% assign option1 = product.options_with_values[0] %}
                <div class="mb-8 product-option-group">
                    <div class="flex items-center gap-3 mb-4">
                        <span class="w-7 h-7 bg-[#1A2B6D] text-white rounded-full flex items-center justify-center text-xs font-black shadow-sm flex-shrink-0">1</span>
                        <h3 class="font-black text-lg uppercase tracking-tight">{{ option1.name | default: 'Escolha o seu plano' }}</h3>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                        {% for value in option1.values %}
                            <label class="cursor-pointer relative flex-1">
                                <input type="radio" name="options[{{ option1.name | escape }}]" value="{{ value | escape }}" class="peer variant-radio" style="position: absolute !important; opacity: 0 !important; width: 0 !important; height: 0 !important; overflow: hidden !important; pointer-events: none !important;" {% if option1.selected_value == value %}checked{% endif %}>
                                <div class="py-4 px-2 text-center rounded-2xl border-2 font-black text-xs uppercase tracking-widest transition-all border-slate-100 text-slate-400 peer-hover:border-slate-200 peer-checked:border-[#2E5BFF] peer-checked:bg-blue-50/50 peer-checked:text-[#1A2B6D]">
                                    {{ value }}
                                </div>
                            </label>
                        {% endfor %}
                    </div>
                </div>
              {% endif %}

              <!-- 2. Data de Ativação -->
              <div class="mb-8">
                  <div class="flex items-center gap-3 mb-4">
                      <span class="w-7 h-7 bg-[#1A2B6D] text-white rounded-full flex items-center justify-center text-xs font-black shadow-sm flex-shrink-0">2</span>
                      <h3 class="font-black text-lg uppercase tracking-tight">Data de ativação</h3>
                  </div>
                  <div class="relative max-w-sm cursor-pointer" onclick="document.getElementById('activation-date-input').showPicker();">
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 top-1/2 -translate-y-1/2 text-[#2E5BFF] pointer-events-none"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                      <input 
                          type="date" 
                          id="activation-date-input"
                          name="properties[Data de Ativação]"
                          required
                          class="w-full h-12 bg-slate-50 border-2 border-slate-100 rounded-2xl py-0 pl-12 pr-4 font-bold text-[#1A2B6D] focus:border-[#2E5BFF] focus:bg-white outline-none transition-all text-sm md:text-base cursor-pointer"
                      />
                  </div>
              </div>

              <!-- 3. Opção Secundária (Dropdown de Duração) -->
              {% if product.options_with_values.size > 1 %}
                {% assign option2 = product.options_with_values[1] %}
                <div class="mb-8 product-option-group">
                    <div class="flex items-center gap-3 mb-4">
                        <span class="w-7 h-7 bg-[#1A2B6D] text-white rounded-full flex items-center justify-center text-xs font-black shadow-sm flex-shrink-0">3</span>
                        <h3 class="font-black text-lg uppercase tracking-tight">{{ option2.name | default: 'Duração da Viagem' }}</h3>
                    </div>
                    
                    <!-- UI do Cadeado (Mostrado via JS para planos com franquia) -->
                    <div id="duration-locked-ui" class="hidden">
                        <div class="relative max-w-sm">
                            <div class="w-full h-12 bg-slate-100 border-2 border-slate-200 rounded-2xl py-0 px-6 font-black text-slate-400 cursor-not-allowed flex items-center justify-center gap-4 shadow-inner text-sm md:text-base">
                                <span>30 Dias</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                            </div>
                        </div>
                        <p class="text-sm font-bold text-slate-500 mt-3 flex items-center justify-start gap-1.5 ml-1">
                           <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00D1FF] flex-shrink-0"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                           Franquia de dados válida por até 30 dias
                        </p>
                    </div>

                    <!-- UI do Select Normal (Mostrado via JS para plano Ilimitado) -->
                    <div id="duration-select-ui" class="relative max-w-sm">
                        <select 
                            id="duration-select-element"
                            name="options[{{ option2.name | escape }}]"
                            class="w-full h-12 bg-slate-50 border-2 border-slate-100 rounded-2xl py-0 pl-5 pr-12 font-black text-[#1A2B6D] focus:border-[#2E5BFF] focus:bg-white outline-none appearance-none transition-all cursor-pointer shadow-sm variant-select text-sm md:text-base"
                        >
                            {% for value in option2.values %}
                                <option value="{{ value | escape }}" {% if option2.selected_value == value %}selected="selected"{% endif %}>
                                    {{ value }}
                                </option>
                            {% endfor %}
                        </select>
                        <div class="absolute right-4 top-1/2 -translate-y-1/2 pointer-events-none">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rotate-90 text-slate-300"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                        </div>
                    </div>
                </div>
              {% endif %}

              <!-- Master Variant Select (Oculto) -->
              <select name="id" id="master-variant-select" class="hidden">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}" data-price="{{ variant.price }}" {% if variant == product.selected_or_first_available_variant %}selected="selected"{% endif %}>
                    {{ variant.title }} - {{ variant.price | money }}
                  </option>
                {% endfor %}
              </select>

              <!-- Inferior: Preço e Botão de Comprar -->
              <div class="pt-8 border-t border-slate-100 flex-grow flex flex-col justify-end">
                  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-4">
                      <div class="flex items-center gap-2 font-black text-[#1A2B6D]">
                          <span class="text-2xl" id="product-price">{{ product.selected_or_first_available_variant.price | money }}</span>
                      </div>
                      <div class="flex flex-wrap sm:flex-nowrap items-center gap-4 bg-slate-50 p-2 rounded-3xl w-full sm:w-auto justify-center">
                           <div class="flex items-center gap-4 px-4 py-2">
                              <button type="button" onclick="document.getElementById('quantity').stepDown()" class="text-slate-300 hover:text-[#1A2B6D] transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg></button>
                              <input type="number" id="quantity" name="quantity" value="1" min="1" class="font-black text-xl w-12 text-center bg-transparent border-none outline-none appearance-none p-0 text-[#1A2B6D]">
                              <button type="button" onclick="document.getElementById('quantity').stepUp()" class="text-slate-300 hover:text-[#1A2B6D] transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><line x1="12" y1="5" x2="12" y2="19"></line></svg></button>
                           </div>
                           <button type="submit" class="bg-[#1A2B6D] text-white px-8 py-5 rounded-2xl font-black shadow-lg hover:bg-[#2E5BFF] transition-all flex items-center justify-center gap-3 active:scale-95 uppercase tracking-widest text-xs w-full sm:w-auto">
                              COMPRAR 
                              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                           </button>
                      </div>
                  </div>
              </div>
            {% endform %}
        </div>
      </div>

      <!-- Países com Cobertura -->
      <div class="lg:col-span-12 mt-4">
        <div class="max-w-5xl mx-auto bg-white rounded-[40px] p-10 border border-slate-100 shadow-sm overflow-hidden relative">
           <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10 relative z-10">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-blue-50 text-[#2E5BFF] rounded-2xl flex items-center justify-center shadow-sm">
                   <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                </div>
                <h2 class="font-black text-2xl tracking-tight text-[#1A2B6D]">Países com Cobertura do {{ product.title }}</h2>
              </div>
           </div>
           
           <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-x-4 gap-y-3 relative z-10">
              {% assign has_paises = false %}
              {% assign paises_array = "" | split: "," %}
              
              {% if product.metafields.custom.paises_cobertos != blank %}
                {% assign has_paises = true %}
                {% assign paises_array = product.metafields.custom.paises_cobertos.value %}
              {% endif %}
              
              {% if product.metafields.custom.paises_cobertos_texto != blank %}
                {% assign has_paises = true %}
                {% assign texto_cru = product.metafields.custom.paises_cobertos_texto.value | replace: '
', ',' | replace: '\n', ',' %}
                {% assign texto_array = texto_cru | split: ',' %}
                {% if paises_array.size > 0 %}
                   {% assign paises_array = paises_array | concat: texto_array %}
                {% else %}
                   {% assign paises_array = texto_array %}
                {% endif %}
              {% endif %}

              {% if has_paises %}
                {% for pais in paises_array %}
                  {% if pais == blank %}{% continue %}{% endif %}
                  {% assign parts = pais | split: ':' %}
                  {% assign code = parts[0] | downcase | strip %}
                  {% assign name = parts[1] | default: pais | strip %}
                  
                  <div class="flex items-center gap-3 p-3 bg-slate-50/50 hover:bg-white hover:shadow-md border border-transparent hover:border-slate-100 rounded-2xl transition-all group">
                    <div class="text-xl leading-none flex-shrink-0 w-8 flex justify-center">
                       <img src="https://cdnjs.cloudflare.com/ajax/libs/flag-icons/6.11.1/flags/4x3/{{ code }}.svg" alt="{{ name }}" class="w-6 h-auto shadow-sm rounded-sm object-cover" onerror="this.style.display='none'">
                    </div>
                    <span class="text-xs font-bold text-slate-700 group-hover:text-[#1A2B6D] leading-tight">{{ name }}</span>
                  </div>
                {% endfor %}
              {% else %}
                <!-- Fallback / Exemplo Visual caso o Metacampo não esteja preenchido -->
                {% assign exemplos = "us:Estados Unidos,gb:Reino Unido,fr:França,de:Alemanha,it:Itália,es:Espanha" | split: "," %}
                {% for pais in exemplos %}
                  {% assign parts = pais | split: ':' %}
                  {% assign code = parts[0] | downcase | strip %}
                  {% assign name = parts[1] | default: pais | strip %}
                  
                  <div class="flex items-center gap-3 p-3 bg-slate-50/50 hover:bg-white hover:shadow-md border border-transparent hover:border-slate-100 rounded-2xl transition-all group opacity-70">
                    <div class="text-xl leading-none flex-shrink-0 w-8 flex justify-center">
                       <img src="https://cdnjs.cloudflare.com/ajax/libs/flag-icons/6.11.1/flags/4x3/{{ code }}.svg" alt="{{ name }}" class="w-6 h-auto shadow-sm rounded-sm object-cover" onerror="this.style.display='none'">
                    </div>
                    <span class="text-xs font-bold text-slate-700 group-hover:text-[#1A2B6D] leading-tight">{{ name }}</span>
                  </div>
                {% endfor %}
                <div class="col-span-full mt-2 text-xs text-amber-600 font-bold bg-amber-50 p-3 rounded-xl border border-amber-100">
                  ⚠️ Estes são países de exemplo. Para mostrar os países reais, preencha o Metacampo "paises_cobertos" no painel do produto.
                </div>
              {% endif %}
           </div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const radios = document.querySelectorAll('.variant-radio');
    const selects = document.querySelectorAll('.variant-select');
    const masterSelect = document.getElementById('master-variant-select');
    const priceDisplay = document.getElementById('product-price');
    const variants = {{ product.variants | json }};
    
    // Elementos da UI de Duração
    const durationLockedUI = document.getElementById('duration-locked-ui');
    const durationSelectUI = document.getElementById('duration-select-ui');
    const durationSelectElement = document.getElementById('duration-select-element');
    
    function updateVariant() {
      let selectedOptions = [];
      
      const checkedRadios = document.querySelectorAll('.variant-radio:checked');
      let isFixedPlan = false;

      checkedRadios.forEach(r => {
        selectedOptions.push(r.value);
        const val = r.value.toLowerCase();
        // Reconhece '10', '20', '30', etc independente de como foi digitado
        if(val.includes('10') || val.includes('20') || val.includes('30') || val.includes('50') || val.includes('franquia')) {
           isFixedPlan = true;
        }
      });
      
      // Toggle dinâmico da UI de duração
      if(durationLockedUI && durationSelectUI && durationSelectElement) {
         if(isFixedPlan) {
            durationSelectUI.classList.add('hidden');
            durationLockedUI.classList.remove('hidden');
            // Força o valor para 30 Dias no carrinho
            durationSelectElement.value = "30 Dias"; 
         } else {
            durationLockedUI.classList.add('hidden');
            durationSelectUI.classList.remove('hidden');
         }
      }

      selects.forEach(s => selectedOptions.push(s.value));
      
      const matchedVariant = variants.find(variant => {
        return selectedOptions.every(opt => variant.options.includes(opt));
      });
      
      if (matchedVariant) {
        masterSelect.value = matchedVariant.id;
        const formatter = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
        priceDisplay.textContent = formatter.format(matchedVariant.price / 100);
      }
    }
    
    radios.forEach(radio => radio.addEventListener('change', updateVariant));
    selects.forEach(select => select.addEventListener('change', updateVariant));
    
    // Executa uma vez no load para garantir o estado inicial correto
    updateVariant();
  });
</script>

{% schema %}
{
  "name": "Página de Produto",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_top_choice",
      "label": "Mostrar selo de destaque (Ex: Top Choice)",
      "default": true
    },
    {
      "type": "text",
      "id": "top_choice_text",
      "label": "Texto do selo",
      "default": "Top Choice em 2026"
    },
    {
      "type": "page",
      "id": "compatibility_page",
      "label": "Página de Compatibilidade",
      "info": "Selecione a página que abrirá ao clicar no aviso de compatibilidade."
    }
  ]
}
{% endschema %}
