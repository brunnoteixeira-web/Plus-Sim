  {
    "type": "text",
    "id": "contact_heading",
    "label": "Título de Contato",
    "default": "Ainda com dúvidas?"
  },
  {
    "type": "text",
    "id": "contact_subheading",
    "label": "Subtítulo de Contato",
    "default": "Nossa equipe está pronta para te ajudar."
  },
  {
    "type": "text",
    "id": "whatsapp_link",
    "label": "Link do WhatsApp",
    "default": "https://wa.me/13213104764"
  }
],
"blocks": [
  {
    "type": "faq",
    "name": "Pergunta Frequente",
    "settings": [
      {
        "type": "text",
        "id": "question",
        "label": "Pergunta"
      },
      {
        "type": "textarea",
        "id": "answer",
        "label": "Resposta"
      }
    ]
  }
],
"presets": [
  {
    "name": "Dúvidas Frequentes"
  }
]
}
