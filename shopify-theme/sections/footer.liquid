<footer class="bg-[#1A2B6D] text-white pt-20 pb-12 relative overflow-hidden">
  <!-- DECORAÇÃO DE FUNDO DO FOOTER -->
  <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-gradient-to-bl from-[#2E5BFF]/20 to-transparent rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
  <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-gradient-to-tr from-[#A64DFF]/20 to-transparent rounded-full blur-3xl translate-y-1/3 -translate-x-1/4"></div>

  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-3 gap-8 text-center md:text-left relative z-10">
      
      <!-- LOGO E REDES SOCIAIS -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
          <div class="mb-6 mt-3">
              <a href="{{ routes.root_url }}">
                  {% if section.settings.logo != blank %}
                      <img src="{{ section.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" class="h-16 md:h-20 w-auto object-contain" />
                  {% else %}
                      <span class="text-2xl font-black text-white">{{ shop.name }}</span>
                  {% endif %}
              </a>
          </div>
          <p class="text-sm leading-relaxed font-medium mb-4 max-w-xs text-white/80">Conectividade em alta velocidade para viajantes. Sem fronteiras, sem complicações.</p>
          <div class="flex gap-4">
              <a href="{{ section.settings.facebook_link }}" target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-all">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              </a>
              <a href="{{ section.settings.instagram_link }}" target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-all">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </a>
              <a href="{{ section.settings.whatsapp_link }}" target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-all">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              </a>
          </div>
      </div>

      <!-- MENU DE LINKS -->
      <div class="flex flex-col items-center md:items-start">
          <h5 class="text-white font-black mb-4 uppercase text-lg tracking-widest">Links</h5>
          <ul class="space-y-3 text-sm font-bold flex flex-col items-center md:items-start">
              <li><a href="/collections/esim" class="hover:text-[#00D1FF] transition-colors">Planos eSIM</a></li>
              <li><a href="/collections/chip-fisico" class="hover:text-[#00D1FF] transition-colors">Planos Chip Físico</a></li>
              <li><a href="/pages/compatibilidade" class="hover:text-[#00D1FF] transition-colors">Compatibilidade eSIM</a></li>
              <li><a href="/blogs/news" class="hover:text-[#00D1FF] transition-colors">Blog</a></li>
              <li><a href="/pages/parceiros" class="hover:text-[#00D1FF] transition-colors">Seja Nosso Parceiro</a></li>
              <li><a href="/policies/terms-of-service" class="hover:text-[#00D1FF] transition-colors">Termos e Condições</a></li>
              <li><a href="/policies/privacy-policy" class="hover:text-[#00D1FF] transition-colors">Privacidade</a></li>
          </ul>
      </div>

      <!-- CONTATO -->
      <div class="flex flex-col items-center md:items-start">
          <h5 class="text-white font-black mb-4 uppercase text-lg tracking-widest">Contato</h5>
          <ul class="space-y-3 text-sm font-bold flex flex-col items-start w-max mx-auto md:mx-0">
              <li class="flex items-center justify-start gap-3">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00D1FF]"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg> 
                  <span>{{ section.settings.phone_us }}</span>
              </li>
              <li class="flex items-center justify-start gap-3">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00D1FF] font-bold"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg> 
                  <span>{{ section.settings.phone_br }}</span>
              </li>
              <li class="flex items-center justify-start gap-3">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00D1FF]"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg> 
                  <span>{{ section.settings.email }}</span>
              </li>
              <li class="flex items-start justify-start gap-3 leading-tight">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00D1FF] flex-shrink-0"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> 
                  <span class="text-white/70 text-xs text-left">{{ section.settings.address | newline_to_br }}</span>
              </li>
          </ul>
      </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 pt-8 mt-8 border-t border-white/5 text-center text-[9px] uppercase tracking-[0.3em] font-black opacity-30 relative z-10">
      © {{ 'now' | date: "%Y" }} {{ shop.name }} - CONECTANDO VOCÊ AO MUNDO
  </div>
</footer>

{% schema %}
{
  "name": "Rodapé",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo do Rodapé"
    },
    {
      "type": "text",
      "id": "facebook_link",
      "label": "Link do Facebook",
      "default": "https://facebook.com/plussimtravel"
    },
    {
      "type": "text",
      "id": "instagram_link",
      "label": "Link do Instagram",
      "default": "https://instagram.com/plussim_travel"
    },
    {
      "type": "text",
      "id": "whatsapp_link",
      "label": "Link do WhatsApp",
      "default": "https://wa.me/13213104764"
    },
    {
      "type": "text",
      "id": "phone_us",
      "label": "Telefone EUA",
      "default": "+1(321)310-4764"
    },
    {
      "type": "text",
      "id": "phone_br",
      "label": "Telefone BR",
      "default": "+55(11)4680-6732"
    },
    {
      "type": "text",
      "id": "email",
      "label": "E-mail de Contato",
      "default": "info@plussim.com"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Endereço Físico",
      "default": "4700 Millenia Blvd, Suite 175\nOrlando/FL - 32839"
    }
  ]
}
{% endschema %}
