<div class="min-h-screen bg-[#F8FAFC] pb-24 pt-12 animate-in fade-in duration-500">
  <div class="max-w-6xl mx-auto px-6">
    
    <div class="mb-10 text-center md:text-left">
      <h1 class="text-4xl md:text-5xl font-black text-[#1A2B6D] tracking-tighter">Seu Carrinho</h1>
      {% if cart.item_count > 0 %}
        <p class="text-slate-500 font-medium mt-2">Revise seus planos e finalize sua compra com segurança.</p>
      {% endif %}
    </div>

    {% if cart.item_count == 0 %}
      <!-- CARRINHO VAZIO -->
      <div class="bg-white rounded-[40px] p-12 md:p-20 text-center shadow-xl border border-white flex flex-col items-center justify-center min-h-[50vh]">
        <div class="w-24 h-24 bg-slate-50 rounded-full flex items-center justify-center mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        </div>
        <h2 class="text-3xl font-black text-[#1A2B6D] mb-4">O carrinho está vazio</h2>
        <p class="text-slate-500 font-medium mb-10 max-w-sm mx-auto">Você ainda não escolheu nenhum plano. Explore nossos destinos e escolha o plano perfeito para sua viagem!</p>
        <a href="{{ routes.root_url }}" class="bg-[#1A2B6D] text-white px-10 py-5 rounded-2xl font-black shadow-lg hover:bg-[#2E5BFF] transition-all uppercase tracking-widest text-sm inline-flex items-center gap-3">
          Ver Planos
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
    {% else %}
      <!-- CARRINHO COM PRODUTOS -->
      <form action="{{ routes.cart_url }}" method="post" id="cart-form" class="grid lg:grid-cols-12 gap-10 items-start">
        
        <!-- Lista de Produtos (Esquerda) -->
        <div class="lg:col-span-8 space-y-6">
          {% for item in cart.items %}
            <div class="bg-white rounded-3xl p-6 md:p-8 shadow-sm border border-slate-100 flex flex-col md:flex-row gap-6 md:gap-8 relative group transition-all hover:shadow-md">
              
              <!-- Remover Botão Absoluto -->
              <a href="{{ item.url_to_remove }}" class="absolute top-6 right-6 text-slate-300 hover:text-red-500 transition-colors p-2 bg-slate-50 hover:bg-red-50 rounded-full" title="Remover item">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
              </a>

              <!-- Imagem do Produto -->
              <div class="w-24 h-24 flex-shrink-0 bg-slate-50 rounded-2xl flex items-center justify-center p-2">
                {% if item.image %}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title }}" class="w-full h-full object-contain mix-blend-multiply rounded-xl">
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-300"><polygon points="12 2 22 8.5 22 15.5 12 22 2 15.5 2 8.5 12 2"></polygon><line x1="12" y1="22" x2="12" y2="15.5"></line><polyline points="22 8.5 12 15.5 2 8.5"></polyline><polyline points="2 15.5 12 8.5 22 15.5"></polyline><line x1="12" y1="2" x2="12" y2="8.5"></line></svg>
                {% endif %}
              </div>
              
              <!-- Detalhes e Controles -->
              <div class="flex-grow flex flex-col justify-between">
                <div class="pr-10 mb-4">
                  <a href="{{ item.url }}" class="text-xl font-black text-[#1A2B6D] hover:text-[#2E5BFF] transition-colors leading-tight block mb-2">{{ item.product.title }}</a>
                  
                  <!-- Variantes e Propriedades -->
                  <div class="space-y-1.5">
                    {% unless item.product.has_only_default_variant %}
                      <p class="text-sm font-medium text-slate-500 flex items-center gap-2">
                         <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00D1FF]"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                         {{ item.variant.title }}
                      </p>
                    {% endunless %}
                    
                    {% for property in item.properties %}
                      {% assign property_first_char = property.first | slice: 0 %}
                      {% if property.last != blank and property_first_char != '_' %}
                        <p class="text-sm font-medium text-slate-500 flex items-center gap-2">
                           <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#2E5BFF]"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                           {{ property.first }}: <span class="font-bold text-[#1A2B6D]">
                             {% if property.first contains 'Data' and property.last contains '-' %}
                               {% assign date_parts = property.last | split: '-' %}
                               {% if date_parts.size == 3 %}
                                 {{ date_parts[2] }}/{{ date_parts[1] }}/{{ date_parts[0] }}
                               {% else %}
                                 {{ property.last }}
                               {% endif %}
                             {% else %}
                               {{ property.last }}
                             {% endif %}
                           </span>
                        </p>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>

                <!-- Quantidade e Preço -->
                <div class="flex items-center justify-between border-t border-slate-50 pt-4 mt-auto">
                  <div class="flex items-center bg-slate-50 rounded-xl p-1">
                    <button type="button" class="qty-btn minus w-8 h-8 flex items-center justify-center text-slate-400 hover:text-[#1A2B6D] hover:bg-white rounded-lg transition-all" data-index="{{ forloop.index }}">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    </button>
                    <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" class="w-10 text-center bg-transparent font-black text-[#1A2B6D] outline-none border-none p-0 text-sm cart-qty-input" data-index="{{ forloop.index }}">
                    <button type="button" class="qty-btn plus w-8 h-8 flex items-center justify-center text-slate-400 hover:text-[#1A2B6D] hover:bg-white rounded-lg transition-all" data-index="{{ forloop.index }}">
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><line x1="12" y1="5" x2="12" y2="19"></line></svg>
                    </button>
                  </div>
                  
                  <div class="text-right">
                    {% if item.original_line_price != item.final_line_price %}
                      <p class="text-xs text-slate-400 line-through mb-0.5">{{ item.original_line_price | money }}</p>
                    {% endif %}
                    <p class="text-xl font-black text-[#1A2B6D]">{{ item.final_line_price | money }}</p>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
          
          <div class="text-right hidden" id="update-cart-container">
             <button type="submit" name="update" class="text-sm font-bold text-[#2E5BFF] underline hover:text-[#1A2B6D]">Atualizar Valores</button>
          </div>
        </div>

        <!-- Resumo do Pedido (Direita) -->
        <div class="lg:col-span-4 sticky top-6">
          <div class="bg-white rounded-[32px] p-8 shadow-xl border border-white">
            <h3 class="text-lg font-black text-[#1A2B6D] uppercase tracking-widest mb-6 border-b border-slate-50 pb-4">Resumo</h3>
            
            <div class="space-y-4 mb-8">
              <div class="flex justify-between items-center text-slate-500 font-medium text-sm">
                <span>Subtotal</span>
                <span class="font-bold text-[#1A2B6D] text-base">{{ cart.total_price | money }}</span>
              </div>
              
              {% if cart.total_discount > 0 %}
                <div class="flex justify-between items-center text-green-500 font-medium text-sm">
                  <span>Desconto PIX 5%</span>
                  <span class="font-bold">-{{ cart.total_discount | money }}</span>
                </div>
              {% endif %}
              
              <div class="pt-4 border-t border-slate-50 flex justify-between items-center">
                <span class="font-black text-[#1A2B6D] text-lg">Total</span>
                <span class="font-black text-[#1A2B6D] text-2xl">{{ cart.total_price | money }}</span>
              </div>
              <p class="text-xs text-slate-400 text-right mt-1">Chip Físico: Frete calculado na próxima etapa.</p>
            </div>
            <div class="mb-6">
              <label for="discount" class="block text-xs font-bold text-slate-400 mb-2 uppercase tracking-wider">Cupom de Desconto</label>
              <div class="relative">
                <input type="text" name="discount" id="discount" class="w-full bg-slate-50 border border-slate-200 text-slate-700 text-sm rounded-xl px-4 py-3 focus:outline-none focus:border-[#2E5BFF] focus:ring-1 focus:ring-[#2E5BFF] transition-all uppercase" placeholder="Digite seu cupom">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
              </div>
            </div>
            
            <button type="submit" name="checkout" class="w-full bg-[#1A2B6D] text-white px-8 py-5 rounded-2xl font-black shadow-[0_10px_30px_rgb(26,43,109,0.2)] hover:shadow-[0_15px_40px_rgb(26,43,109,0.3)] hover:-translate-y-1 hover:bg-[#2E5BFF] transition-all uppercase tracking-widest text-sm flex items-center justify-center gap-3">
              FINALIZAR COMPRA
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </button>
            
            <div class="mt-6 flex items-center justify-center gap-3 text-xs font-bold text-slate-400">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
              COMPRA 100% SEGURA
            </div>
          </div>
        </div>
      </form>
      
      <script>
        document.addEventListener('DOMContentLoaded', () => {
          const form = document.getElementById('cart-form');
          const minusBtns = document.querySelectorAll('.qty-btn.minus');
          const plusBtns = document.querySelectorAll('.qty-btn.plus');
          const inputs = document.querySelectorAll('.cart-qty-input');
          const updateBtnContainer = document.getElementById('update-cart-container');

          function triggerUpdate() {
             // Opcional: mostrar botão de atualizar ou auto-submit
             // Auto-submit proporciona experiência mais fluída no Shopify padrão sem AJAX cart
             form.submit(); 
          }

          minusBtns.forEach((btn, idx) => {
            btn.addEventListener('click', () => {
              const input = inputs[idx];
              if (input.value > 0) {
                input.value = parseInt(input.value) - 1;
                triggerUpdate();
              }
            });
          });

          plusBtns.forEach((btn, idx) => {
            btn.addEventListener('click', () => {
              const input = inputs[idx];
              input.value = parseInt(input.value) + 1;
              triggerUpdate();
            });
          });

          inputs.forEach(input => {
            input.addEventListener('change', triggerUpdate);
          });
        });
      </script>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Página do Carrinho",
  "settings": []
}
{% endschema %}
