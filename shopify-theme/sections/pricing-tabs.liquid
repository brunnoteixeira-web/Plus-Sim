<section class="py-24 bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col items-center mb-16 gap-6">
          <h2 class="text-4xl md:text-5xl font-black text-[#1A2B6D] tracking-tighter text-center">{{ section.settings.heading }}</h2>
          <div class="flex bg-slate-100 p-2 rounded-[24px] border border-slate-200 shadow-inner" id="pricing-tabs">
              <button data-tab="esim" class="px-8 py-3.5 rounded-[18px] font-black text-xs uppercase tracking-widest transition-all flex items-center gap-2 bg-[#2E5BFF] text-white shadow-lg shadow-[#2E5BFF]/30">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><rect x="7" y="7" width="3" height="3"></rect><rect x="14" y="7" width="3" height="3"></rect><rect x="7" y="14" width="3" height="3"></rect><rect x="14" y="14" width="3" height="3"></rect></svg> 
                  eSIM
              </button>
              <button data-tab="physical" class="px-8 py-3.5 rounded-[18px] font-black text-xs uppercase transition-all flex items-center gap-2 text-slate-500 hover:text-slate-800">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg> 
                  Chip Físico
              </button>
          </div>
      </div>

      <!-- ESIM GRID -->
      <div id="grid-esim" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {% for block in section.blocks %}
              {% if block.settings.category == 'esim' %}
              <div class="group bg-white rounded-[32px] p-8 transition-all duration-500 hover:-translate-y-2 relative flex flex-col cursor-pointer border border-slate-100 shadow-[0_8px_30px_rgb(0,0,0,0.06)] hover:shadow-[0_20px_40px_rgb(46,91,255,0.12)]">
                  <div class="flex justify-between items-start mb-6">
                      <div class="w-12 h-12 rounded-2xl bg-[#F3E8FF] text-[#A64DFF] flex items-center justify-center">
                          {% render 'destination-icon', title: block.settings.title %}
                      </div>
                      {% if block.settings.promo != blank %}
                          <div class="px-4 py-1.5 text-[10px] font-black uppercase tracking-widest rounded-full shadow-sm bg-[#00D1FF]/10 text-[#00D1FF]">{{ block.settings.promo }}</div>
                      {% endif %}
                  </div>
                  <div class="mb-6">
                      <h3 class="text-2xl font-black text-[#1A2B6D] mb-2 leading-tight">{{ block.settings.title }}</h3>
                      <p class="text-slate-500 font-medium flex items-baseline gap-1">a partir de <span class="text-[#1A2B6D] font-black text-xl">R${{ block.settings.price }}</span></p>
                  </div>
                  <ul class="space-y-4 mb-10 flex-grow">
                      {% assign features = block.settings.features | split: "," %}
                      {% for feature in features %}
                          <li class="flex items-start gap-3">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00D1FF] flex-shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
                              <span class="text-slate-600 text-sm font-medium">{{ feature | strip }}</span>
                          </li>
                      {% endfor %}
                  </ul>
                  <a href="{{ block.settings.link }}" class="w-full block text-center py-4 rounded-xl font-black text-xs uppercase border-2 border-[#1A2B6D] text-[#1A2B6D] hover:bg-[#1A2B6D] hover:text-white transition-all">Ver Detalhes</a>
              </div>
              {% endif %}
          {% endfor %}
      </div>

      <!-- CHIP FISICO GRID -->
      <div id="grid-physical" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 hidden">
          {% for block in section.blocks %}
              {% if block.settings.category == 'physical' %}
              <div class="group bg-white rounded-[32px] p-8 transition-all duration-500 hover:-translate-y-2 relative flex flex-col cursor-pointer border border-slate-100 shadow-[0_8px_30px_rgb(0,0,0,0.06)] hover:shadow-[0_20px_40px_rgb(46,91,255,0.12)]">
                  <div class="flex justify-between items-start mb-6">
                      <div class="w-12 h-12 rounded-2xl bg-[#00D1FF]/10 text-[#00D1FF] flex items-center justify-center">
                          {% render 'destination-icon', title: block.settings.title %}
                      </div>
                      {% if block.settings.promo != blank %}
                          <div class="px-4 py-1.5 text-[10px] font-black uppercase tracking-widest rounded-full shadow-sm bg-[#A64DFF]/10 text-[#A64DFF]">{{ block.settings.promo }}</div>
                      {% endif %}
                  </div>
                  <div class="mb-6">
                      <h3 class="text-2xl font-black text-[#1A2B6D] mb-2 leading-tight">{{ block.settings.title }}</h3>
                      <p class="text-slate-500 font-medium flex items-baseline gap-1">a partir de <span class="text-[#1A2B6D] font-black text-xl">R${{ block.settings.price }}</span></p>
                  </div>
                  <ul class="space-y-4 mb-10 flex-grow">
                      {% assign features = block.settings.features | split: "," %}
                      {% for feature in features %}
                          <li class="flex items-start gap-3">
                              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[#00D1FF] flex-shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
                              <span class="text-slate-600 text-sm font-medium">{{ feature | strip }}</span>
                          </li>
                      {% endfor %}
                  </ul>
                  <a href="{{ block.settings.link }}" class="w-full block text-center py-4 rounded-xl font-black text-xs uppercase border-2 border-[#1A2B6D] text-[#1A2B6D] hover:bg-[#1A2B6D] hover:text-white transition-all">Ver Detalhes</a>
              </div>
              {% endif %}
          {% endfor %}
      </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
      const tabs = document.querySelectorAll('#pricing-tabs button');
      const gridEsim = document.getElementById('grid-esim');
      const gridPhysical = document.getElementById('grid-physical');

      tabs.forEach(tab => {
          tab.addEventListener('click', () => {
              // Reseta classes
              tabs.forEach(t => {
                  t.className = 'px-8 py-3.5 rounded-[18px] font-black text-xs uppercase tracking-widest transition-all flex items-center gap-2 text-slate-500 hover:text-slate-800';
              });

              // Ativa o clicado
              tab.className = 'px-8 py-3.5 rounded-[18px] font-black text-xs uppercase tracking-widest transition-all flex items-center gap-2 bg-[#2E5BFF] text-white shadow-lg shadow-[#2E5BFF]/30';

              if(tab.dataset.tab === 'esim') {
                  gridEsim.classList.remove('hidden');
                  gridPhysical.classList.add('hidden');
              } else {
                  gridEsim.classList.add('hidden');
                  gridPhysical.classList.remove('hidden');
              }
          });
      });
  });
</script>

{% schema %}
{
  "name": "Escolha seu Destino",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título Principal",
      "default": "Escolha o seu Destino"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Card de Produto",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Categoria",
          "options": [
            { "value": "esim", "label": "eSIM" },
            { "value": "physical", "label": "Chip Físico" }
          ],
          "default": "esim"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Destino (Ex: Estados Unidos)",
          "default": "Estados Unidos"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Preço base (Ex: 259)",
          "default": "259"
        },
        {
          "type": "text",
          "id": "promo",
          "label": "Etiqueta Promocional",
          "info": "Deixe em branco para ocultar"
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Benefícios (Separados por vírgula)",
          "default": "Internet Ilimitada, Velocidade 5G/4G, Mantenha seu WhatsApp"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link do Produto"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Planos e Destinos",
      "blocks": [
        { "type": "product_card", "settings": { "category": "esim", "title": "Estados Unidos", "price": "259", "features": "Plano com Internet Ilimitada, Plano Controle com 10Gb ou 20Gb, Velocidade 5G/4G, Mantenha seu número de WhatsApp" } },
        { "type": "product_card", "settings": { "category": "esim", "title": "Europa", "price": "329", "features": "Plano com Internet Ilimitada, Plano Controle com 10Gb ou 20Gb, Cobertura em 28 Países, Mantenha seu número de WhatsApp" } },
        { "type": "product_card", "settings": { "category": "esim", "title": "Ásia", "price": "289", "features": "Plano com Internet Ilimitada, Plano Controle com 10Gb ou 20Gb, Velocidade 5G/4G, Mantenha seu número de WhatsApp" } },
        { "type": "product_card", "settings": { "category": "physical", "title": "Estados Unidos", "price": "299", "features": "Internet Ilimitada, Velocidade 5G/4G, Receba o Chip em casa, Mantenha seu número de WhatsApp" } },
        { "type": "product_card", "settings": { "category": "physical", "title": "Europa", "price": "369", "features": "Internet Ilimitada, Cobertura em 42 países, Velocidade 5G/4G, Mantenha seu número de WhatsApp" } }
      ]
    }
  ]
}
{% endschema %}
